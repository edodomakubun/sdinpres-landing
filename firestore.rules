rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Koleksi postingan SD Inpres Lelingluan
    // Proteksi admin dilakukan di frontend (admin.html) melalui verifikasi akun Edo Domakubun
    match /posts/{postId} {
      allow read, write: if true;
    }
    
    // Koleksi pengaturan (opsional)
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}
